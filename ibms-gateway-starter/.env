# 项目编码，容器和卷的前缀
COMPOSE_PROJECT_NAME=ibms
# 网关编码，网关采集的指标都会附加 gateway_code 标签，用来区分指标来源
IBMS_GATEWAY_CODE=
# 采集数据推送地址 | <scheme>://<host>[:<port>]
IBMS_DATA_ORIGIN=
# 网关外部地址 | <scheme>://<host>[:<port>]
IBMS_GATEWAY_ORIGIN=
# Grafana 用户
GF_SECURITY_ADMIN_USER=
# Grafana 密码
GF_SECURITY_ADMIN_PASSWORD=
# 网关数据库 root 密码
IBMS_GATEWAY_DATABASE_ROOT_PASSWORD=
# BACnet网络接口
IBMS_GATEWAY_BACNET_IFACE=eth0
# 网关地址，prometheus-agent会从该地址采集数据
IBMS_GATEWAY_HOST=localhost
# Web 服务器端口
IBMS_GATEWAY_PORT=8080
